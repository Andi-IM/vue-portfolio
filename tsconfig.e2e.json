{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": ["e2e/**/*", "playwright.config.ts"],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "src/*": ["./src/*"],
      "components/*": ["./src/components/*"],
      "layouts/*": ["./src/layouts/*"],
      "pages/*": ["./src/pages/*"],
      "assets/*": ["./src/assets/*"],
      "boot/*": ["./src/boot/*"]
    }
  }
}
