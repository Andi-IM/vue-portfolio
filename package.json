{
  "name": "vue-portfolio",
  "productName": "Andi IM | Portfolio",
  "productDescription": "Andi Irham - Mobile App Developer & AI Enthusiast. Specializing in Android, Kotlin, Flutter development.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "quasar dev",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "quasar build && vite preview --outDir dist",
    "build-only": "quasar build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix --cache",
    "lint": "run-s lint:*",
    "format": "prettier --write src/",
    "dev:wrangler": "npm run build && wrangler pages dev dist --kv=BLOG_KV --r2=BLOG_BUCKET",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:coverage": "npx cross-env VITE_COVERAGE=true playwright test && npx nyc report --reporter=text --reporter=html",
    "clean": "rimraf dist coverage .nyc_output .quasar test-results playwright-report .eslintcache .wrangler tsconfig.app.tsbuildinfo"
  },
  "dependencies": {
    "@codecov/vite-plugin": "^1.9.1",
    "@intlify/unplugin-vue-i18n": "^11.0.3",
    "@quasar/extras": "^1.17.0",
    "lucide-vue-next": "^0.562.0",
    "quasar": "^2.18.6",
    "sass": "^1.97.1",
    "slate": "^0.120.0",
    "slate-history": "^0.113.1",
    "slate-vue3": "^0.11.4",
    "vue": "^3.5.22",
    "vue-i18n": "^11.2.8",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@prettier/plugin-oxc": "^0.1.3",
    "@quasar/app-vite": "^2.4.0",
    "@tailwindcss/vite": "^4.1.17",
    "@tsconfig/node22": "^22.0.2",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.0.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitejs/plugin-vue-jsx": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.16",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.22",
    "cross-env": "^10.1.0",
    "eslint": "^9.37.0",
    "eslint-plugin-oxlint": "~1.36.0",
    "eslint-plugin-quasar": "^1.1.0",
    "eslint-plugin-vue": "~10.5.0",
    "jiti": "^2.6.1",
    "jsdom": "^27.4.0",
    "npm-run-all2": "^8.0.4",
    "nyc": "^17.1.0",
    "oxlint": "~1.36.0",
    "postcss": "^8.5.6",
    "prettier": "3.6.2",
    "rimraf": "^6.1.2",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.0",
    "vite-plugin-checker": "^0.12.0",
    "vite-plugin-istanbul": "^7.2.1",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vitest": "^4.0.16",
    "vue-tsc": "^3.1.1",
    "wrangler": "^4.54.0"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20",
    "npm": ">=9.16.0",
    "yarn": ">=1.22.19"
  }
}
