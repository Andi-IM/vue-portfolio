{
  "name": "vue-portfolio",
  "productName": "Andi IM | Portfolio",
  "description": "Andi Irham - Mobile App Developer & AI Enthusiast. Specializing in Android, Kotlin, Flutter development.",
  "author": "Andi-IM <andi.irhamm@gmail.com>",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "quasar dev",
    "postinstall": "quasar prepare",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "quasar build && vite preview --outDir dist",
    "build-only": "quasar build",
    "type-check": "vue-tsc --build tsconfig.build.json",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint src --ext .js,.ts,.vue --fix --cache",
    "lint": "run-s lint:*",
    "format": "prettier --write src/",
    "dev:wrangler": "bun run build && wrangler pages dev dist/spa --d1=BLOG_DB=ad047f20-6a71-4048-bb25-415748436b72 --kv=BLOG_CACHE --r2=BLOG_BUCKET --persist-to=.wrangler/state",
    "dev:remote": "bun run build && wrangler pages dev dist/spa",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:coverage": "npx cross-env VITE_COVERAGE=true playwright test && npx nyc report --reporter=text --reporter=html",
    "clean": "rimraf dist coverage .nyc_output .quasar test-results playwright-report .eslintcache .wrangler tsconfig.app.tsbuildinfo"
  },
  "dependencies": {
    "@codecov/vite-plugin": "^1.9.1",
    "@iconify-json/simple-icons": "^1.2.65",
    "@iconify/vue": "^5.0.0",
    "@intlify/unplugin-vue-i18n": "^11.0.3",
    "@quasar/extras": "^1.17.0",
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.3.1",
    "google-auth-library": "^10.5.0",
    "googleapis": "^169.0.0",
    "lucide-vue-next": "^0.563.0",
    "quasar": "^2.18.6",
    "sass": "^1.97.3",
    "slate": "^0.120.0",
    "slate-history": "^0.113.1",
    "slate-vue3": "^0.11.4",
    "vue": "^3.5.22",
    "vue-i18n": "^11.2.8",
    "vue-router": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@prettier/plugin-oxc": "^0.1.3",
    "@quasar/app-vite": "^2.4.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tailwindcss/vite": "^4.1.17",
    "@tsconfig/node22": "^22.0.2",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.1.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitejs/plugin-vue-jsx": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.24",
    "cross-env": "^10.1.0",
    "eslint": "^9.37.0",
    "eslint-plugin-oxlint": "~1.36.0",
    "eslint-plugin-quasar": "^1.1.0",
    "eslint-plugin-vue": "~10.5.0",
    "jiti": "^2.6.1",
    "jsdom": "^27.4.0",
    "npm-run-all2": "^8.0.4",
    "nyc": "^17.1.0",
    "oxlint": "~1.36.0",
    "postcss": "^8.5.6",
    "prettier": "3.6.2",
    "rimraf": "^6.1.2",
    "semantic-release": "^25.0.5",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.0",
    "vite-plugin-checker": "^0.12.0",
    "vite-plugin-istanbul": "^7.2.1",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.1.1",
    "wrangler": "^4.61.1"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20",
    "npm": ">=9.16.0",
    "yarn": ">=1.22.19"
  }
}
